// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
}

enum AccountCategory {
  CASH
  BANK_ACCOUNT
  TAIWAN_STOCK
  US_STOCK
  JAPAN_STOCK
  KOREA_STOCK
  CRYPTO
  FIXED_ASSET
  RECEIVABLE
  PAYABLE
  MORTGAGE
  CAR_LOAN
  CREDIT_LOAN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  LOAN_PAYMENT
  AUTO_DEDUCTION
}

enum Currency {
  TWD
  USD
  JPY
  KRW
  EUR
  GBP
  HKD
  CNY
  AUD
  CAD
  SGD
}

enum SubscriptionTier {
  FREE
  PRO
}

// 訂閱狀態：ACTIVE/TRIALING 視為有效，其餘一律當作沒有訂閱權限（過期後別自動當 FREE，
// 保留最後狀態方便之後做「已取消但還在計費週期內」之類的顯示）
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELED
  EXPIRED
  PAST_DUE
}

// 🌟 新增：用户表
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?  // 可为 null（如果用 OAuth）

  // 未来扩展：Google/GitHub OAuth
  googleId      String?  @unique
  githubId      String?  @unique
  appleId       String?  @unique

  emailVerified Boolean  @default(false)
  verificationToken String? // 邮件验证 token
  verificationTokenExpires DateTime?

  // 🌟 訂閱／付費方案：目前先只做資料層與功能開關骨架，尚未接金流。
  // provider/customerId/subscriptionId 留給之後串 Stripe 或 Apple IAP 時填入。
  subscriptionTier      SubscriptionTier   @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscriptionProvider  String?            // "stripe" | "apple_iap" | "manual"
  subscriptionExpiresAt DateTime?          // null 表示無期限（例如手動贈送、或 FREE 方案本身不看這欄位）
  trialEndsAt           DateTime?
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique

  // 这个用户的所有资产
  accounts      Account[]
  history       AssetHistory[]
  transactions  Transaction[]
  goals         Goal[]
  syncLogs      SyncLog[]
  activityLogs  ActivityLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([email])
}

model Account {
  id            String          @id @default(cuid())
  userId        String          // 🌟 新增：这条账户属于哪个用户
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  type          AccountType
  category      AccountCategory
  symbol        String?
  quantity      Float?          @default(0)
  currentPrice  Float?          @default(0)
  currentValue  Float           @default(0)
  currency      Currency        @default(TWD)
  isApiConnected Boolean        @default(false)
  apiSource     String?
  apiKey        String?
  apiSecret     String?
  apiPassphrase String?
  lastApiSyncAt DateTime?
  apiSyncError  String?
  monthlyDeductionAmount Float?
  deductionDate Int?
  deductFromAccountId String?
  interestRate  Float?          // 年利率（%），非必填；有填才會在自動扣款時拆分本金/利息
  loanTermMonths Int?           // 總期數（月），非必填；只用來顯示「已繳/總期數」進度
  loanStartDate DateTime?       // 貸款起算日（=第 1 期扣款日），非必填；有填才能算出「已繳幾期」，不然只能用交易紀錄筆數概算
  isActive      Boolean         @default(true)
  archivedAt    DateTime?       // 封存（isActive:false）的時間；用來判斷 60 天後是否該永久刪除
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  Transaction[]
  loanPayments  Transaction[]   @relation("LoanPayments")

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String          // 🌟 新增：这笔交易属于哪个用户
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Float
  quantity    Float?
  price       Float?
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  loanAccountId String?
  loanAccount   Account?       @relation("LoanPayments", fields: [loanAccountId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([type])
  @@index([date])
}

enum ActivityType {
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_ARCHIVED
  ACCOUNT_RESTORED
  ACCOUNT_DELETED
}

// 帳戶本身的新增／編輯／封存／刪除紀錄；金錢進出（記帳、自動扣款…）已經有 Transaction 記錄，這裡只補帳戶異動這塊空白，
// 「近期紀錄」彈窗把兩張表依時間合併顯示。
model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  description String
  amount      Float?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AssetHistory {
  id              String   @id @default(cuid())
  userId          String   // 🌟 新增：这个历史记录属于哪个用户
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date            DateTime
  totalAssets     Float
  totalLiabilities Float
  netWorth        Float
  breakdown       String
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// Free 方案「每 4 小時最多手動同步 3 次」限流用的呼叫紀錄；Pro 不受限，不會寫入這裡查詢的限制邏輯。
model SyncLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedAt  DateTime @default(now())

  @@index([userId, syncedAt])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String   // 目標名稱，例如「買房頭期款」
  targetAmount Float   // 目標金額（NT$）；type = DEBT_PAYOFF 時代表這筆負債最初的總金額
  type        String   @default("NET_WORTH") // NET_WORTH、ACCOUNT 或 DEBT_PAYOFF
  accountId   String?  // type = ACCOUNT 或 DEBT_PAYOFF 時，指定哪個帳戶（DEBT_PAYOFF 必須是負債帳戶）
  emoji       String?  // 可選的 emoji，例如 🏠

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

