// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
}

enum AccountCategory {
  CASH
  BANK_ACCOUNT
  TAIWAN_STOCK
  US_STOCK
  CRYPTO
  FIXED_ASSET
  RECEIVABLE
  PAYABLE
  MORTGAGE
  CAR_LOAN
  CREDIT_LOAN
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  LOAN_PAYMENT
  AUTO_DEDUCTION
}

enum Currency {
  TWD
  USD
}

// 🌟 新增：用户表
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?  // 可为 null（如果用 OAuth）
  
  // 未来扩展：Google/GitHub OAuth
  googleId      String?  @unique
  githubId      String?  @unique
  
  emailVerified Boolean  @default(false)
  verificationToken String? // 邮件验证 token
  verificationTokenExpires DateTime?
  
  // 这个用户的所有资产
  accounts      Account[]
  history       AssetHistory[]
  transactions  Transaction[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([email])
}

model Account {
  id            String          @id @default(cuid())
  userId        String          // 🌟 新增：这条账户属于哪个用户
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  type          AccountType
  category      AccountCategory
  symbol        String?
  quantity      Float?          @default(0)
  currentPrice  Float?          @default(0)
  currentValue  Float           @default(0)
  currency      Currency        @default(TWD)
  isApiConnected Boolean        @default(false)
  apiSource     String?
  apiKey        String?
  apiSecret     String?
  monthlyDeductionAmount Float?
  deductionDate Int?
  deductFromAccountId String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  Transaction[]
  loanPayments  Transaction[]   @relation("LoanPayments")

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([isActive])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String          // 🌟 新增：这笔交易属于哪个用户
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Float
  quantity    Float?
  price       Float?
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  loanAccountId String?
  loanAccount   Account?       @relation("LoanPayments", fields: [loanAccountId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([type])
  @@index([date])
}

model AssetHistory {
  id              String   @id @default(cuid())
  userId          String   // 🌟 新增：这个历史记录属于哪个用户
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date            DateTime
  totalAssets     Float
  totalLiabilities Float
  netWorth        Float
  breakdown       String
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}